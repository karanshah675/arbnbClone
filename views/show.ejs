<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= data.title %></title>
</head>
<body>

  
    <ul>
        <li><%= data.title %></li>
        <li><%= data.description %></li>
        <li><%= data.price.toLocaleString("en-in") %></li>
        <li><%= data.location %></li>
        <li><%= data.country %></li>
        <li><form action="/listing/<%= data.id %>/edit" method="get">
            <button>Edit list</button>
        </form></li>
        <li><form action="/listing/<%= data._id %>?_method=DELETE" method="post">
            <button>Delete list</button>
        </form></li>
    </ul>
</body>
</html>